# Cloudflare Pages response headers. Mirrors nginx.conf; tests/staticHostHeaders.test.ts
# fails if the two drift apart. Fonts are bundled, so the CSP allows only 'self'.
# Cloudflare Pages applies EVERY matching rule and joins duplicate header values with
# a comma, so Cache-Control is kept out of the catch-all: otherwise "no-cache" would be
# merged into the immutable /assets/* value and defeat the long-lived cache.
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: no-referrer
  Content-Security-Policy: default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self'; script-src 'self'; connect-src 'self'; manifest-src 'self'; worker-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'

/
  Cache-Control: no-cache

/index.html
  Cache-Control: no-cache

/manifest.webmanifest
  Cache-Control: no-cache

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/sw.js
  Cache-Control: no-cache, no-store, must-revalidate
